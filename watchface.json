{
  "sdk_version": "3.0.0",
  "device_id": "xiaomi.smartband.10",
  "device_type": "smart_band",
  "meta": {
    "name": "Apple Style Fixed",
    "version": "1.0.3",
    "author": "Custom",
    "description": "Apple Watch Stretched Style with Fixed Complication"
  },
  "settings": {
    "fps": 30,
    "hardware_acceleration": true,
    "cache_resources": true
  },
  "theme": {
    "default_color_index": 0,
    "color_palettes": [
      { "name": "Apple Umber", "primary": "#D4A373", "secondary": "#7A5C43" },
      { "name": "Pure White", "primary": "#FFFFFF", "secondary": "#888888" }
    ]
  },
  "views": {
    "main": {
      "background": { "color": "#000000" },
      "components": [
        {
          "type": "date",
          "format": "EEE, d MMM",
          "locale": "ru_RU",
          "x": 96, "y": 45,
          "align": "center",
          "font": "system_16",
          "color": "@theme.primary"
        },
        {
          "type": "time_images",
          "x": 96, "y": 120,
          "align": "center",
          "spacing": -1,
          "resource_prefix": "assets/Stretched_",
          "color_mask": "@theme.primary"
        },
        {
          "type": "complication_slot",
          "id": "slot_bottom",
          "x": 96, "y": 370,
          "align": "center",
          "radius": 28,
          "supported_types": ["steps", "heart_rate", "sleep", "flashlight"],
          "default_type": "steps",
          "style": {
            "icon_color": "@theme.primary",
            "progress_color": "@theme.primary",
            "bg_color": "#1A1A1A"
          }
        }
      ]
    },
    "aod": {
      "enabled": true,
      "background": { "color": "#000000" },
      "components": [
        {
          "type": "time_images",
          "x": 96, "y": 120,
          "align": "center",
          "spacing": -1,
          "resource_prefix": "assets/Stretched_",
          "color_mask": "@theme.secondary"
        }
      ]
    }
  }
}
