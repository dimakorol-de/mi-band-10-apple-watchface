{
  "sdk_version": "3.0.0",
  "device_id": "xiaomi.smartband.10",
  "device_type": "smart_band",
  "meta": {
    "name": "Apple Style Handcrafted",
    "version": "1.0.6",
    "author": "Custom",
    "description": "Apple Watch Stretched Style Handcrafted"
  },
  "settings": {
    "fps": 30,
    "hardware_acceleration": true,
    "cache_resources": true
  },
  "views": {
    "main": {
      "background": { "color": "#000000" },
      "components": [
        {
          "type": "date",
          "format": "EEE, d MMM",
          "locale": "ru_RU",
          "x": 96, "y": 45,
          "align": "center",
          "font": "system_16",
          "color": "#D4A373"
        },
        {
          "type": "time_images",
          "x": 96, "y": 120,
          "align": "center",
          "spacing": -1,
          "resource_prefix": "assets/Stretched_"
        },
        {
          "type": "complication_slot",
          "id": "slot_bottom",
          "x": 96, "y": 370,
          "align": "center",
          "radius": 28,
          "supported_types": ["steps", "heart_rate", "sleep", "flashlight"],
          "default_type": "steps",
          "style": {
            "icon_color": "#D4A373",
            "progress_color": "#D4A373",
            "bg_color": "#1A1A1A"
          }
        }
      ]
    },
    "aod": {
      "enabled": true,
      "background": { "color": "#000000" },
      "components": [
        {
          "type": "time_images",
          "x": 96, "y": 120,
          "align": "center",
          "spacing": -1,
          "resource_prefix": "assets/Stretched_"
        }
      ]
    }
  }
}
